rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "12benabdallah@gmail.com") || 
        ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "17benabdallah@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "role" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Collections ---

    // الطلبيات: التاجر يرى طلبياته، والآدمن يرى الكل، والكل ينشئ طلبية (للمتجر العام)
    match /orders/{orderId} {
      allow read, update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (request.query.limit <= 100 || isAdmin());
      allow create: if true;
    }

    match /orderItems/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() && (
        (exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
         get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid) || 
        isAdmin()
      );
    }

    match /inventory/{itemId} {
      allow read: if true; // Storefront and public reviews
      allow write: if isSignedIn() && (
        (incoming().userId == request.auth.uid || existing().userId == request.auth.uid) || 
        isAdmin()
      );
    }

    match /merchant_configs/{merchantId} {
      allow read, write: if isOwner(merchantId) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if true;
    }

    match /_system_health/{docId} {
      allow read: if true;
    }

    match /support_messages/{messageId} {
      allow create: if true; 
      allow read, list, delete: if isAdmin();
      allow update: if false;
    }
  }
}
