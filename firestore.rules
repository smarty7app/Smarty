rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      let hasRequiredKeys = data.keys().hasAll(['uid', 'email']);
      let isIdValid = data.uid == request.auth.uid;
      let isEmailValid = data.email is string && data.email.size() <= 256;
      
      // Optional fields can be null or string
      let isNameValid = data.get('displayName', '') == null || (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100);
      let isPhotoValid = data.get('photoURL', '') == null || (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 512);
      
      let isGenerationsValid = (data.get('generationsCount', 0) is int);
      let isStatusValid = (data.get('subscriptionStatus', 'free') in ['free', 'basic', 'pro']);
      let isExpiryValid = data.get('subscriptionExpiresAt', '') == null || data.get('subscriptionExpiresAt', '') is string;

      return hasRequiredKeys && isIdValid && isEmailValid && isNameValid && isPhotoValid && isGenerationsValid && isStatusValid && isExpiryValid;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().get('generationsCount', 0) == 0 &&
                    incoming().get('subscriptionStatus', 'free') == 'free' &&
                    incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Profile Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])) ||
        // Action: Increment Generations
        (incoming().diff(existing()).affectedKeys().hasOnly(['generationsCount']) && 
         incoming().generationsCount == (existing().get('generationsCount', 0) + 1)) ||
        // Action: Subscription Update
        (incoming().diff(existing()).affectedKeys().hasOnly(['subscriptionStatus', 'subscriptionExpiresAt']))
      );
    }

    // Plans collection
    match /plans/{planId} {
      allow read: if true;
      allow write: if false; // System only
    }
  }
}
