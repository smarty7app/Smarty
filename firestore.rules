rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "12benabdallah@gmail.com" || 
        request.auth.token.email == "17benabdallah@gmail.com" || 
        request.auth.token.email == "smarty7.app@gmail.com"
      );
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true; // Public for storefront check
      allow write, delete: if isSignedIn() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true; // Public checkout
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write, delete: if isSignedIn() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /subscription_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true; // Allowed for contact form
      allow update, delete: if isAdmin();
    }

    match /merchant_configs/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /merchant_public_configs/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    match /orderItems/{itemId} {
      allow read: if isSignedIn() && (get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid || isAdmin());
      allow create: if true; // Public storefront checkout write fallback
      allow update, delete: if isSignedIn() && (get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid || isAdmin());
    }
  }
}
