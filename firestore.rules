rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "12benabdallah@gmail.com") || 
        ("email" in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == "17benabdallah@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         "role" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
                    (existing().userId == request.auth.uid && (request.query.limit == null || request.query.limit <= 100)) ||
                    isAdmin()
                  );
      
      allow create: if (
                      isSignedIn() && 
                      ("customerName" in incoming() && incoming().customerName is string) &&
                      ("phoneNumber" in incoming() && incoming().phoneNumber is string) &&
                      incoming().userId == request.auth.uid &&
                      (!("createdAt" in incoming()) || incoming().createdAt == request.time)
                    ) || (
                      // Secure guest checkout order creation
                      ("customerName" in incoming() && incoming().customerName is string) &&
                      ("phoneNumber" in incoming() && incoming().phoneNumber is string) &&
                      ("userId" in incoming() && incoming().userId is string) &&
                      incoming().status == "pending" &&
                      (!("createdAt" in incoming()) || incoming().createdAt == request.time)
                    );
      
      allow update: if isSignedIn() && 
                    (existing().userId == request.auth.uid || isAdmin()) &&
                    ("customerName" in incoming() && incoming().customerName is string) &&
                    ("phoneNumber" in incoming() && incoming().phoneNumber is string) &&
                    incoming().userId == existing().userId &&
                    (!("createdAt" in incoming()) || incoming().createdAt == existing().createdAt) && (
                      incoming().diff(existing()).affectedKeys().hasAny(['status', 'deliveryType', 'commune', 'customerName', 'phoneNumber', 'wilaya', 'possibleFake', 'note', 'shippingCompany', 'trackingNumber', 'labelUrl', 'locationUrl', 'items', 'shippingFee', 'totalPrice'])
                    );
      
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- OrderItem Validation ---
    function isValidOrderItem(data) {
      return data.orderId is string &&
             data.productName is string && data.productName.size() <= 250 &&
             data.quantity is int && data.quantity >= 0 &&
             data.size is string && data.size.size() <= 50 &&
             data.color is string && data.color.size() <= 50;
    }

    match /orderItems/{itemId} {
      // Identity check: The parent order must belong to the user
      function parentOrderBelongsToUser(orderId) {
        return get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
      }

      allow read, list: if isSignedIn() && (parentOrderBelongsToUser(existing().orderId) || isAdmin());
      
      allow create: if isSignedIn() && 
                    isValidOrderItem(incoming()) && 
                    parentOrderBelongsToUser(incoming().orderId);
      
      allow update: if isSignedIn() && 
                    (parentOrderBelongsToUser(existing().orderId) || isAdmin()) &&
                    isValidOrderItem(incoming()) &&
                    incoming().orderId == existing().orderId &&
                    incoming().diff(existing()).affectedKeys().hasAny(['productName', 'quantity', 'size', 'color']);
      
      allow delete: if isSignedIn() && (parentOrderBelongsToUser(existing().orderId) || isAdmin());
    }

    match /inventory/{itemId} {
      allow read, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    function isValidUser(data) {
      return (data.planType == null || data.planType in ['free', 'pro', 'unlimited']) &&
             (data.orderCounter == null || data.orderCounter is int) &&
             (data.subscriptionStatus == null || data.subscriptionStatus in ['active', 'pending_verification', 'expired']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
                    incoming().planType == "free" && 
                    incoming().orderCounter == 0 &&
                    incoming().subscriptionStatus == "active";
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || (
                      (!("email" in incoming()) || !("email" in existing()) || incoming().email == existing().email) &&
                      incoming().diff(existing()).affectedKeys().hasAny(['orderCounter', 'displayName', 'subscriptionStatus'])
                    ));
      allow list: if isAdmin();
    }

    match /subscription_requests/{requestId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == "pending";
      allow list: if isSignedIn() && (isAdmin() || request.query.limit <= 100);
      allow update: if isAdmin();
    }

    match /merchant_configs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
