rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (First Rule Block)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
               request.auth.token.email == "12benabdallah@gmail.com" || 
               request.auth.token.email == "17benabdallah@gmail.com" || 
               request.auth.token.email == "smarty7.app@gmail.com"
             );
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isMemberOrOwner(merchantId) {
      return isSignedIn() && (
        request.auth.uid == merchantId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'parentMerchantId' in getUserData(request.auth.uid) &&
         getUserData(request.auth.uid).parentMerchantId == merchantId)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles Collection
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['merchant', 'admin', 'manager', 'support', 'warehouse'];
    }

    match /users/{uid} {
      allow get, list: if isOwner(uid) || isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).parentMerchantId == uid);
      allow create: if isOwner(uid) && isValidUser(incoming()) && (
        (incoming().role == 'merchant') ||
        (incoming().role in ['manager', 'support', 'warehouse'] && 
         exists(/databases/$(database)/documents/team_members/$(incoming().email.lower())) &&
         get(/databases/$(database)/documents/team_members/$(incoming().email.lower())).data.role == incoming().role &&
         get(/databases/$(database)/documents/team_members/$(incoming().email.lower())).data.ownerId == incoming().parentMerchantId)
      );
      allow update: if (isOwner(uid) && isValidUser(incoming()) && 
                        incoming().role == existing().role && 
                        (!('parentMerchantId' in incoming()) || incoming().parentMerchantId == existing().parentMerchantId) &&
                        (!('subscriptionPlan' in incoming()) || incoming().subscriptionPlan == existing().subscriptionPlan) &&
                        (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == existing().subscriptionStatus)) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Inventory Items
    function isValidInventory(data) {
      return data.productName is string && data.productName.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.price is number && data.price >= 0 &&
             data.stockQuantity is number && data.stockQuantity >= 0 &&
             data.sku is string && data.sku.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.isPublished is bool;
    }

    match /inventory/{itemId} {
      allow read: if true; // Public for storefront check
      allow create: if isSignedIn() && isMemberOrOwner(incoming().userId) && 
                      (getUserData(request.auth.uid).role in ['merchant', 'manager']) && 
                      isValidInventory(incoming()) && isValidId(itemId);
      allow update: if (
        isSignedIn() && 
        isMemberOrOwner(existing().userId) && 
        isMemberOrOwner(incoming().userId) && 
        isValidInventory(incoming()) && (
          // Manager or Owner can update anything
          (getUserData(request.auth.uid).role in ['merchant', 'manager']) ||
          // Warehouse can ONLY update stockQuantity
          (getUserData(request.auth.uid).role == 'warehouse' && 
           incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity']))
        )
      ) || isAdmin();
      allow delete: if (isSignedIn() && isMemberOrOwner(existing().userId) && 
                        (getUserData(request.auth.uid).role in ['merchant', 'manager'])) || isAdmin();
    }

    // 3. Orders (Highly Hardened)
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() <= 200 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 128 &&
             data.wilaya is string && data.wilaya.size() <= 128 &&
             data.status in ["pending", "confirmed", "shipped", "delivered", "returned", "canceled"] &&
             data.userId is string && data.userId.size() <= 128 &&
             data.items is list && data.items.size() <= 20 &&
             data.totalPrice is number && data.totalPrice >= 0;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (isMemberOrOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn() && (isMemberOrOwner(resource.data.userId) || isAdmin());
      
      allow create: if (
        // Public/Anonymous Storefront Checkout:
        // Ensures that anyone can place an order, but they are strictly locked down:
        // - Order must be 'pending' state
        // - Cannot set administrative fields (trackingNumber, labelUrl)
        // - The merchant ID (userId) actually exists in /users collection
        (!isSignedIn() || !isMemberOrOwner(incoming().userId)) && 
        isValidOrder(incoming()) && 
        incoming().status == "pending" && 
        (!('trackingNumber' in incoming()) || incoming().trackingNumber == "") &&
        (!('labelUrl' in incoming()) || incoming().labelUrl == "") &&
        exists(/databases/$(database)/documents/users/$(incoming().userId))
      ) || (
        // Merchant Owner/Creator/Team Checkout:
        isSignedIn() && 
        isMemberOrOwner(incoming().userId) && 
        (getUserData(request.auth.uid).role in ['merchant', 'manager', 'support']) &&
        isValidOrder(incoming()) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId))
      ) || isAdmin();

      allow update: if (
        isSignedIn() && 
        isMemberOrOwner(existing().userId) && 
        isMemberOrOwner(incoming().userId) && 
        isValidOrder(incoming()) && (
          // Owner / Manager / Support can update anything
          (getUserData(request.auth.uid).role in ['merchant', 'manager', 'support']) ||
          // Warehouse can ONLY update status, trackingNumber, labelUrl, shipping_company, delivery_type
          (getUserData(request.auth.uid).role == 'warehouse' && 
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingNumber', 'labelUrl', 'shipping_company', 'delivery_type']))
        )
      ) || isAdmin();

      allow delete: if (isSignedIn() && isMemberOrOwner(existing().userId) && (getUserData(request.auth.uid).role in ['merchant', 'manager'])) || isAdmin();
    }

    // 4. Order Items (Public checkout fallback/backwards-compatibility)
    match /orderItems/{itemId} {
      allow read: if isSignedIn() && (get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(itemId) && 
                      incoming().orderId is string && 
                      incoming().orderId.size() <= 128 && 
                      exists(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update, delete: if isSignedIn() && (get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid || isAdmin());
    }

    // 5. Notifications
    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.type in ["success", "info", "warning", "error"];
    }

    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidNotification(incoming()) && exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidNotification(incoming());
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. Subscription Requests
    match /subscription_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().planType in ['pro', 'elite'];
      allow update, delete: if isAdmin();
    }

    // 7. Support Messages (Allowed for contact form)
    match /support_messages/{messageId} {
      allow read: if isAdmin();
      allow create: if incoming().email is string && incoming().email.size() <= 128 &&
                      incoming().message is string && incoming().message.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // 8. Merchant Configuration
    match /merchant_configs/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // 9. Merchant Public Configuration
    match /merchant_public_configs/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    // 10. Merchant Connections
    match /merchant_connections/{merchantId} {
      allow read, write: if isOwner(merchantId) || isAdmin();
    }

    // 11. Incoming Messages Stream (Webhook Logging)
    function isValidIncomingMessage(data) {
      return data.merchantId is string && data.merchantId.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.platform in ["facebook", "instagram", "whatsapp"] &&
             data.text is string && data.text.size() <= 5000 &&
             data.status in ["pending", "processed", "failed"];
    }

    match /incoming_messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.merchantId == request.auth.uid || isAdmin());
      allow create: if isValidIncomingMessage(incoming()) && exists(/databases/$(database)/documents/users/$(incoming().merchantId));
      allow update, delete: if isSignedIn() && (resource.data.merchantId == request.auth.uid || isAdmin());
    }

    // 12. Team Members Management
    match /team_members/{email} {
      allow get: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidId(incoming().ownerId);
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && incoming().ownerId == request.auth.uid;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
