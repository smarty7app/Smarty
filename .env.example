# ================================================================
# Smarty AI - متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وأضف قيمك الحقيقية
# ================================================================

# ----------------------------------------------------------------
# 🤖 Gemini AI API Key (مطلوب لتشغيل الذكاء الاصطناعي)
# احصل عليه من: https://aistudio.google.com/apikey
# ----------------------------------------------------------------
VITE_GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ملاحظة: يمكن أيضاً استخدام GEMINI_API_KEY (للنشر على Vercel/Render)
# GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ----------------------------------------------------------------
# 🔥 Firebase Configuration (اختياري - للمصادقة وقاعدة البيانات)
# احصل عليه من: https://console.firebase.google.com
# إذا لم تُهيَّأ، يعمل التطبيق بوضع Demo (بدون تخزين سحابي)
# ----------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ----------------------------------------------------------------
# 🌐 App URL (للنشر على الخادم)
# ----------------------------------------------------------------
APP_URL=http://localhost:3000
