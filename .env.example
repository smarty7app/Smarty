# مفتاح واجهة برمجة تطبيقات Gemini (مطلوب للنصوص وتحليل الصور)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# مفتاح واجهة برمجة تطبيقات Together AI (مطلوب لتوليد الصور عبر نموذج SDXL/Flux)
VITE_TOGETHER_API_KEY=your_together_api_key_here

# رابط استضافة التطبيق (اختياري)
VITE_APP_URL=https://smartyai.net
