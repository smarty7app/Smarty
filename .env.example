# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional variable to customize the AI model for parsing chats.
# Defaults to "gemini-3.5-flash" if not specified.
# GEMINI_MODEL="gemini-3.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Yalidine API Configuration
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""

# ZR Express API Configuration
ZR_API_KEY=""

# Maystro Delivery API Configuration
MAYSTRO_ID=""
MAYSTRO_API_KEY=""

# EcoTrack API Configuration
ECOTRACK_TOKEN=""

# Anderson API Configuration
ANDERSON_USER=""
ANDERSON_PASS=""

# Chargily Pay V2 API credentials (accept payment via CIB, Edahabia, BaridiMob)
# Use "test_sk_..." for development and "live_sk_..." for production
CHARGILY_SECRET_KEY="your-chargily-secret-key-here"

# Webhook Security
# Used to verify that requests to /webhooks/smarty-orders are legitimate
WEBHOOK_SECRET="generate-a-secure-random-string-here"

# Firebase Client Configuration for Local Development
# Replace these values with your own Firebase project credentials
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""
