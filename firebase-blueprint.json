{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the merchant, sub-user, or admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["merchant", "admin", "manager", "support", "warehouse"] },
        "parentMerchantId": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["free", "pro", "elite"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Team member registration record linking an email to a merchant owner with a specific role",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "ownerId": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "support", "warehouse"] },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "ownerId", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "A product sold by a merchant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "integer" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "merchantId", "name", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "wilaya": { "type": "string" },
        "commune": { "type": "string" },
        "address": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "returned", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "merchantId", "customerName", "customerPhone", "wilaya", "status"]
    },
    "MerchantConnections": {
      "title": "Merchant Connections",
      "description": "Integration configurations for merchant social channels",
      "type": "object",
      "properties": {
        "facebook": {
          "type": "object",
          "properties": {
            "pageId": { "type": "string" },
            "accessToken": { "type": "string" },
            "pageName": { "type": "string" },
            "connectedAt": { "type": "string", "format": "date-time" }
          }
        },
        "instagram": {
          "type": "object",
          "properties": {
            "businessId": { "type": "string" },
            "accessToken": { "type": "string" },
            "connectedAt": { "type": "string", "format": "date-time" }
          }
        },
        "whatsapp": {
          "type": "object",
          "properties": {
            "phoneNumberId": { "type": "string" },
            "accessToken": { "type": "string" },
            "connectedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "IncomingMessage": {
      "title": "Incoming Message",
      "description": "An incoming conversational message from a connected platform",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "senderId": { "type": "string" },
        "platform": { "type": "string", "enum": ["facebook", "instagram", "whatsapp"] },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["merchantId", "senderId", "platform", "text", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile data"
    },
    "/inventory/{itemId}": {
      "schema": "Product",
      "description": "Products available for sale"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/merchant_connections/{merchantId}": {
      "schema": "MerchantConnections",
      "description": "Social media channel connection details per merchant"
    },
    "/incoming_messages/{autoId}": {
      "schema": "IncomingMessage",
      "description": "Stored conversation log streams for order processing and smart replies"
    },
    "/team_members/{email}": {
      "schema": "TeamMember",
      "description": "Team members registered by merchant owners"
    }
  }
}
